# Server only. Copy to .env; never put provider credentials in VITE_* variables.
HOST=0.0.0.0
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=data/runs
# Optional shared access token; all /lab requests support it. Empty = no API authentication.
API_TOKEN=
# Empty = same origin. Comma-separated origins for a separate frontend.
CORS_ORIGIN=
TRUST_PROXY=false
MAX_UPLOAD_MB=10

# Provider ids: mock, openai, yandexgpt, ollama, llamacpp.
LLM_PROVIDER=mock
# Explicit ordered fallback chain for flows that allow fallback. Benchmark always disables it.
LLM_FALLBACK=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_PER_MIN=20

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
OPENAI_PRICE_CURRENCY=USD

YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net
YANDEX_MODEL=yandexgpt-lite/latest
YANDEX_PRICE_INPUT_PER_1M=
YANDEX_PRICE_OUTPUT_PER_1M=
YANDEX_PRICE_CURRENCY=RUB

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=local
LLAMACPP_API_KEY=
MOCK_LLM_FAIL=
MOCK_LLM_LATENCY_MS=0

# Docker Compose: public port, binding, optional build identifier.
APP_PORT=8787
APP_BIND_ADDRESS=127.0.0.1
APP_COMMIT=
OLLAMA_DOCKER_BASE_URL=http://ollama:11434
